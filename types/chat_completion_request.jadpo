/// What asking a model for a chat completion takes: the model, the
/// conversation and the most tokens it may answer with.
public type ChatCompletionRequest = Object {
    model: Text {
        max_length: 200
    }
    messages: List<ChatCompletionMessage> {
        min_length: 1
    }
    max_completion_tokens: Int {
        min: 1
        max: 1000000
    }
}
