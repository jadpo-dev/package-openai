/// OpenAI's API, each request carrying the project's API key as a bearer
/// credential. The connection gives its address,
/// `https://api.openai.com/v1`, in `host:`.
provider {
    protocol: Protocol.json_http
    credential: CredentialScheme.bearer
    error_code: "error.code"
    // Each public type, gone through against OpenAI's API reference on
    // 2026-11-07.
    reviewed: [
        ChatCompletion,
        ChatCompletionChoice,
        ChatCompletionChunk,
        ChatCompletionChunkChoice,
        ChatCompletionDelta,
        ChatCompletionMessage,
        ChatCompletionReply,
        ChatCompletionRequest,
        CompletionUsage,
        CreateEmbeddingResponse,
        EmbeddingData,
        EmbeddingRequest,
        EmbeddingUsage,
        EmbeddingVector,
        PromptTokensDetails,
        StreamedChatCompletionRequest
    ]
}
